# ─── Datenbank ──────────────────────────────────────────────────────────────
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
# Async-URL (vom Backend genutzt)
DATABASE_URL=postgresql+asyncpg://traffic:traffic@127.0.0.1:5432/traffic
# Sync-URL (für Alembic)
DATABASE_URL_SYNC=postgresql://traffic:traffic@127.0.0.1:5432/traffic

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Media / Beweis-Storage ─────────────────────────────────────────────────
# Nur "local" in Phase 1.
MEDIA_BACKEND=local
MEDIA_DIR=/var/lib/trafficcontrol/media

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7890
BACKEND_CORS_ORIGINS=http://localhost:5173,http://10.10.1.250

# ─── Worker ─────────────────────────────────────────────────────────────────
# Backend-URL, von der der Worker seine Kamerakonfiguration lädt
WORKER_BACKEND_URL=http://127.0.0.1:7890
# YOLO-Modell: yolo11m (default, beste Genauigkeit) oder yolo11s (schneller)
YOLO_MODEL=yolo11m.pt
# Inferenz-Gerät: nur "cpu" (kein CUDA, kein MPS in LXC)
YOLO_DEVICE=cpu
# Frames pro Sekunde, die zur Anzeige nach Redis gepusht werden
DISPLAY_FPS=12
# Modell-Konfidenz-Schwelle
YOLO_CONF=0.35
