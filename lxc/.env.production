# ─── Datenbank ──────────────────────────────────────────────────────────────
# Q4: local, kein MinIO. Backup via Proxmox-LXC-Snapshot (Q6).
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
# Async-URL (asyncpg). asyncpg nutzt '?ssl=disable' (nicht sslmode).
DATABASE_URL=postgresql+asyncpg://traffic:traffic@127.0.0.1:5432/traffic?ssl=disable
# Sync-URL (psycopg2, fuer Alembic). psycopg2 nutzt '?sslmode=disable'.
DATABASE_URL_SYNC=postgresql://traffic:traffic@127.0.0.1:5432/traffic?sslmode=disable

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Media / Beweis-Storage ─────────────────────────────────────────────────
MEDIA_BACKEND=local
MEDIA_DIR=/var/lib/trafficcontrol/media

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7890
# CORS-Origins: nur die Adressen, die das Frontend auch tatsächlich aufruft
BACKEND_CORS_ORIGINS=http://10.10.1.250,http://localhost

# ─── Worker ─────────────────────────────────────────────────────────────────
# Backend-URL, von der der Worker seine Kamerakonfiguration lädt
WORKER_BACKEND_URL=http://127.0.0.1:7890
# YOLO-Modell: yolo11m (default, beste Genauigkeit) oder yolo11s (schneller)
YOLO_MODEL=yolo11m.pt
# Inferenz-Gerät: nur "cpu" (kein CUDA, kein MPS in LXC)
YOLO_DEVICE=cpu
# Frames pro Sekunde, die zur Anzeige nach Redis gepusht werden
DISPLAY_FPS=12
YOLO_CONF=0.35

# ─── Retention (Phase 6) ────────────────────────────────────────────────────
# Hard-Floor: cleanup-evidence lehnt kleinere Werte ab
CLEANUP_MIN_AGE_DAYS=7
